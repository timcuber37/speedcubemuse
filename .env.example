# Discord Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_guild_id_here

# Anthropic (Claude) Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-5

# API cost tracking: logs and background writes to api_usage_events in the WCA DB.
# No provider admin key is needed. Estimates exclude credits and discounts.
API_USAGE_ENABLED=true
API_USAGE_PERSIST=true

# WCA API Configuration
WCA_API_BASE_URL=https://www.worldcubeassociation.org/api/v0

# WCA OAuth (register your app at https://www.worldcubeassociation.org/oauth/applications)
WCA_CLIENT_ID=your_wca_oauth_client_id
WCA_CLIENT_SECRET=your_wca_oauth_client_secret
WCA_REDIRECT_URI=http://localhost:5000/auth/wca/callback

# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Flask session secret — use a long random string in production
SECRET_KEY=your_random_secret_key_here

# Database Configuration (Optional - for future local database support)
DATABASE_URL=

# Bot Settings
COMMAND_PREFIX=!wca
MAX_QUERY_RESULTS=50

# Ask a Delegate (RAG)
VOYAGE_API_KEY=your_voyage_api_key
VOYAGE_EMBED_MODEL=voyage-3-large
VOYAGE_RERANK_MODEL=rerank-2-lite
REGULATIONS_REF=official
MAX_GUEST_DELEGATE_QUESTIONS=3
DELEGATE_RETRIEVAL_K=6
DELEGATE_RERANK_INITIAL_K=20
DELEGATE_MAX_HISTORY_TURNS=8

# Guess the Cuber
# Question selection costs nothing (entropy math over the precomputed matrix);
# the model is only used to map a typed question onto a known attribute.
GAME_MODEL=claude-haiku-4-5

# Rate limits, split by what each endpoint costs. Most of the game is free
# (entropy math + an in-process cache), so only the two "ask" endpoints that
# reach Claude are held tight. Set GAME_RATE_LIMITS=false to exempt the game
# entirely - handy locally, and note it also bypasses the app-wide
# 200/day + 50/hour defaults, which are tighter than anything below.
GAME_RATE_LIMITS=true
GAME_LIMIT_FREE=300 per minute
GAME_LIMIT_CHEAP=120 per minute
GAME_LIMIT_ASK=60 per minute
# Guest day-cap on questions that reach Claude. Signed-in users are exempt.
# This is the control that stops an anonymous visitor running up an API bill.
MAX_GUEST_GAME_QUESTIONS=300
